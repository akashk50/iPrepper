# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
DYNAMODB_TABLE=user_scores
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=dsci351-project
VOSK_MODEL_PATH=./models/vosk-model-en-us-0.42-gigaspeech
CAMERA_INDEX=0
